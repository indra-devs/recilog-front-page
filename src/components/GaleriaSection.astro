---
const images = [
	"/images/vehiculos/galeria-1.webp",
	"/images/vehiculos/galeria-2.webp",
	"/images/vehiculos/galeria-3.webp",
	"/images/vehiculos/galeria-4.webp",
	"/images/vehiculos/galeria-5.webp",
	"/images/vehiculos/galeria-6.webp",
	"/images/vehiculos/galeria-7.webp",
	"/images/vehiculos/galeria-8.webp",
	"/images/vehiculos/galeria-9.webp",
];
---

<section class="relative overflow-hidden bg-white px-4 py-12 sm:px-6 md:px-10 md:py-16 lg:px-16 lg:py-[60px] xl:px-24 2xl:px-[240px]">
	<img
		src="/images/illustrations/blueprint-bg.png"
		alt=""
		class="pointer-events-none absolute top-0 left-0 hidden h-auto md:block md:w-[35%] lg:w-[46%]"
	/>

	<div class="relative z-10 flex flex-col items-center gap-10 md:gap-[60px]">
		<div class="flex flex-col items-center gap-2 text-center">
			<h2 class="font-heading text-3xl font-bold text-recilog-dark md:text-4xl lg:text-[54px]">
				Galería de <span class="text-recilog-green-light">Imág</span><span class="text-recilog-green"
					>enes</span
				>
			</h2>
			<p class="max-w-[902px] text-[15px] text-recilog-gray">
				Te dejamos con nuestra galería de imágenes, en donde puedes apreciar nuestros vehículos y
				los servicios que prestamos a las empresas que nos prefieren y confían en nuestro
				servicios.
			</p>
		</div>

		<div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				images.map((image) => (
					<img src={image} alt="" class="aspect-[464/342] w-full rounded-2xl object-cover" />
				))
			}
		</div>
	</div>
</section>
