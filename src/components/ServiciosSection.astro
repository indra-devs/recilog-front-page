---
const servicios = [
	{
		icon: "/images/icons/camioneta.svg",
		iconClass: "size-16 md:size-20 lg:size-[80px] object-contain",
		title: "Transportes de Residuos Industriales",
		titleClass: "text-recilog-green",
		description: "Residuos no peligros de cualquier tipo de industria, grande, mediana o pequeña.",
	},
	{
		icon: "/images/icons/tacho-reciclaje.svg",
		iconClass: "size-16 md:size-20 lg:size-[80px] object-contain",
		title: "Transporte de residuos de la construcción",
		titleClass: "text-recilog-green-light",
		description: "Somos expertos en retiro y acopio de desechos de la construcción.",
	},
	{
		icon: "/images/icons/residuos-domiciliario.svg",
		iconClass: "h-[53px] w-[90px] md:h-[58px] md:w-[100px] lg:h-[66px] lg:w-[113px]",
		title: "Transportes residuos asimilables a domiciliario",
		titleClass: "text-recilog-green",
		description: "Uno de nuestros nuevos servicios 100% garantizado, con el servicio más rápido.",
	},
];
---

<section class="relative overflow-hidden bg-white px-4 py-12 sm:px-6 md:px-10 md:py-16 lg:px-16 lg:py-[60px] xl:px-24 2xl:px-[240px]">
	<img
		src="/images/illustrations/blueprint-bg.png"
		alt=""
		class="pointer-events-none absolute top-0 left-0 hidden h-auto md:block md:w-[35%] lg:w-[46%]"
	/>

	<div class="relative z-10 flex flex-col items-center gap-10 md:gap-[60px]">
		<h2 class="text-center font-heading text-3xl font-bold text-recilog-dark md:text-4xl lg:text-[54px]">
			Nuestros <span class="text-recilog-green">Servicios</span>
		</h2>

		<div class="flex w-full flex-col items-center gap-6 lg:flex-row">
			<div class="flex h-auto flex-1 flex-col items-start justify-center gap-4 px-0 py-0 lg:h-[300px] lg:px-10 lg:py-6">
				<h3 class="w-full font-heading text-2xl leading-tight font-bold text-recilog-dark md:text-3xl lg:text-[50px] lg:leading-[44px]">
					En <span class="text-recilog-green-light">REC</span><span class="text-recilog-green"
						>ILOG</span
					> ponemos al cliente al centro.
				</h3>
				<p class="w-full text-base text-recilog-gray md:text-lg lg:text-[24px]">
					Retiramos escombros y materiales de construcción con soluciones ágiles y eficientes
					para tu obra.
				</p>
			</div>

			<div class="flex w-full flex-1 flex-col gap-6">
				{
					servicios.map((servicio) => (
						<div class="flex items-center gap-4 rounded-2xl p-6 drop-shadow-[0px_0px_10px_rgba(10,31,68,0.1)]">
							<img src={servicio.icon} alt="" class={`shrink-0 ${servicio.iconClass}`} />
							<div class="flex flex-col items-start gap-2">
								<p class={`font-heading text-[20px] font-bold ${servicio.titleClass}`}>
									{servicio.title}
								</p>
								<p class="text-[18px] text-recilog-gray">{servicio.description}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
