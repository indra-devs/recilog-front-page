---
type Servicio = {
	image: string;
	titleAccent: string;
	title: string;
	description: string[];
	imageSide: "left" | "right";
};

const servicios: Servicio[] = [
	{
		image: "/images/servicios/industriales.webp",
		titleAccent: "RECILOG",
		title: "Transportes de residuos industriales",
		description: [
			"En forma mensual se realizan alrededor de 1.200 retiros de tolvas de 30 m3 con residuos recepcionados por CMPC (Sorepa), en vehículos y camiones preparados para este tipo de trabajo, bajo los estándares de una empresa líder en el sector.",
		],
		imageSide: "left",
	},
	{
		image: "/images/servicios/construccion.webp",
		titleAccent: "RECILOG",
		title: "Transporte de residuos de la construcción",
		description: [
			"El retiro y transporte de residuos de construcción es nuestro servicio más solicitado. Por eso, contamos con flota adecuada y tarifas competitivas para cumplir con el estándar y los plazos que requiere cada obra, sin afectar su continuidad. Además, ofrecemos arriendo de contenedores metálicos, optimizando la gestión en terreno y generando ahorro para las empresas.",
		],
		imageSide: "right",
	},
	{
		image: "/images/servicios/domiciliario.webp",
		titleAccent: "RECILOG",
		title: "Transportes residuos asimilables a domiciliario",
		description: [
			"Contamos con un servicio optimizado para el transporte de residuos domiciliarios e industriales, utilizando camiones con dos tolvas de 9 m³. Esto reduce viajes, baja costos operativos y mejora la eficiencia del retiro, generando un ahorro directo para nuestros clientes.",
			"Para residuos domiciliarios no peligrosos, disponemos de un centro de acopio propio, lo que permite gestionar el retiro de forma rápida y cómoda, cumpliendo la normativa vigente.",
		],
		imageSide: "left",
	},
];
---

<section class="relative overflow-hidden bg-white px-4 py-12 sm:px-6 md:px-10 md:py-16 lg:px-16 lg:py-[60px] xl:px-24 2xl:px-[240px]">
	<img
		src="/images/illustrations/blueprint-bg.png"
		alt=""
		class="pointer-events-none absolute top-0 left-0 hidden h-auto md:block md:w-[35%] lg:w-[46%]"
	/>
	<img
		src="/images/contacto/hojas-1.png"
		alt=""
		class="pointer-events-none absolute top-1/4 right-0 hidden w-[200px] rotate-12 md:block md:w-[260px] lg:-right-4 lg:w-[320px]"
	/>
	<img
		src="/images/contacto/hojas-1.png"
		alt=""
		class="pointer-events-none absolute bottom-1/4 left-0 hidden w-[200px] -rotate-12 -scale-x-100 md:block md:w-[260px] lg:-left-4 lg:w-[320px]"
	/>

	<div class="relative z-10 flex flex-col items-center gap-10 md:gap-[60px]">
		<h2 class="text-center font-heading text-3xl font-bold text-recilog-dark md:text-4xl lg:text-[54px]">
			Nuestros <span class="text-recilog-green">Servicios</span>
		</h2>

		<div class="flex w-full flex-col gap-10 md:gap-[60px]">
			{
				servicios.map((servicio) => (
					<div class="flex w-full flex-col items-center gap-6 lg:flex-row lg:gap-6">
						<div
							class:list={[
								"w-full flex-1",
								servicio.imageSide === "right" ? "lg:order-2" : "lg:order-1",
							]}
						>
							<img
								src={servicio.image}
								alt={servicio.title}
								class="aspect-[708/500] w-full rounded-2xl border border-white object-cover"
							/>
						</div>
						<div
							class:list={[
								"flex w-full flex-1 flex-col items-center gap-4 rounded-2xl px-6 py-8 text-center drop-shadow-[0px_0px_10px_rgba(10,31,68,0.1)] md:px-10 md:py-10 lg:items-start lg:gap-4 lg:px-[60px] lg:py-6 lg:text-left",
								servicio.imageSide === "right" ? "lg:order-1" : "lg:order-2",
							]}
						>
							<p class="font-heading text-3xl leading-tight font-extrabold md:text-4xl lg:text-[50px] lg:leading-[51px]">
								<span class="text-recilog-green-light">REC</span><span class="text-recilog-green"
									>ILOG</span
								>
								<span class="block text-recilog-dark">{servicio.title}</span>
							</p>
							{
								servicio.description.map((parrafo) => (
									<p class="text-[15px] text-recilog-gray">{parrafo}</p>
								))
							}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
