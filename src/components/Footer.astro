---
import Logo from "./Logo.astro";

const enlaces = ["Inicio", "Nosotros", "Servicios", "Recilog", "Contacto"];
---

<footer class="flex w-full flex-col items-start">
	<div class="grid w-full grid-cols-1 gap-10 bg-recilog-footer px-4 pt-16 pb-10 sm:grid-cols-2 sm:px-6 md:px-10 md:pt-20 lg:flex lg:flex-row lg:gap-6 lg:px-16 lg:pt-[100px] lg:pb-[60px] xl:px-24 2xl:px-[240px]">
		<div class="flex flex-1 flex-col items-start gap-6 sm:col-span-2 lg:col-span-1">
			<Logo />
			<p class="text-[15px] text-white">
				En <span class="font-bold text-recilog-green">Recilog</span> Transportes contamos con más
				de 15.000 m² de instalaciones, que incluyen oficinas, talleres de mantención para nuestra
				flota, áreas para contenedores y una bomba de combustible propia, autorizada por la SEC.
			</p>
		</div>

		<div class="flex flex-1 flex-col items-start">
			<div class="flex flex-col items-start gap-3">
				<p class="font-heading text-[18px] font-bold text-recilog-green">Enlaces</p>
				{enlaces.map((enlace) => <p class="text-[15px] text-recilog-border-light">{enlace}</p>)}
			</div>
		</div>

		<div class="flex flex-1 flex-col items-start px-[30px]">
			<div class="flex flex-col items-center justify-center gap-6">
				<p class="w-full font-heading text-[18px] font-bold text-recilog-green">Redes Sociales</p>
				<div class="flex w-full items-center gap-3.5">
					<a href="#" aria-label="Facebook" class="relative inline-block size-8">
						<img src="/images/icons/facebook.svg" alt="" class="absolute" style="top: 10.1%; left: 28.4%; width: 43.1%; height: 79.9%" />
					</a>
					<a href="#" aria-label="LinkedIn" class="relative inline-block size-8">
						<img src="/images/icons/linkedin.svg" alt="" class="absolute" style="top: 10%; left: 10%; width: 80%; height: 80%" />
					</a>
					<a href="#" aria-label="Instagram"><img src="/images/icons/instagram.svg" alt="" class="size-8" /></a>
				</div>
			</div>
		</div>

		<div class="flex flex-1 flex-col items-start gap-6">
			<p class="w-full font-heading text-[18px] font-bold text-recilog-green">Contacto</p>

			<div class="flex w-full items-center gap-3">
				<span class="relative inline-block size-6 shrink-0">
					<img src="/images/icons/footer-location-1.svg" alt="" class="absolute" style="top: 29.96%; left: 37%; width: 26%; height: 26%" />
					<img src="/images/icons/footer-location-2.svg" alt="" class="absolute" style="top: 8.33%; left: 14.07%; width: 71.84%; height: 83.32%" />
				</span>
				<p class="flex-1 text-[15px] text-recilog-border-light">
					Av las Acacias 1953, San Bernardo, Santiago, Región Metropolitana
				</p>
			</div>

			<div class="flex w-full items-center gap-3">
				<span class="relative inline-block size-6 shrink-0">
					<img src="/images/icons/clock-1.svg" alt="" class="absolute" style="top: 5.21%; left: 5.21%; width: 89.58%; height: 89.58%" />
					<img src="/images/icons/clock-2.svg" alt="" class="absolute" style="top: 28.17%; left: 45.33%; width: 23.25%; height: 38.21%" />
				</span>
				<p class="text-[15px] text-recilog-border-light">
					<span class="font-bold text-white">Horarios:</span><br />Lunes a viernes de 9:00 hrs a 18:00
					hrs.
				</p>
			</div>

			<div class="flex w-full items-center gap-3">
				<span class="relative inline-block size-6 shrink-0">
					<img src="/images/icons/footer-call-1.svg" alt="" class="absolute" style="top: 5.21%; left: 5.21%; width: 89.46%; height: 89.58%" />
					<img src="/images/icons/footer-call-2.svg" alt="" class="absolute" style="top: 19.79%; left: 59.37%; width: 20.84%; height: 20.84%" />
					<img src="/images/icons/footer-call-3.svg" alt="" class="absolute" style="top: 5.21%; left: 59.38%; width: 35.41%; height: 35.41%" />
				</span>
				<p class="text-[15px] text-recilog-border-light">
					<span class="font-bold text-white">Teléfono:</span><br />+569 9105 60 45
				</p>
			</div>

			<div class="flex w-full items-center gap-3">
				<span class="relative inline-block size-6 shrink-0">
					<img src="/images/icons/footer-sms-1.svg" alt="" class="absolute" style="top: 11.46%; left: 5.21%; width: 89.58%; height: 77.08%" />
					<img src="/images/icons/footer-sms-2.svg" alt="" class="absolute" style="top: 34.37%; left: 26.04%; width: 47.92%; height: 19.23%" />
				</span>
				<p class="text-[15px] text-recilog-border-light">
					<span class="font-bold text-white">Correo electrónico:</span><br />servicios@recilog.cl
				</p>
			</div>
		</div>
	</div>

	<div class="flex w-full flex-col items-center gap-2 bg-white px-4 py-3 sm:flex-row sm:gap-6 sm:px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-[240px]">
		<p class="flex-1 text-center text-[15px] text-recilog-gray sm:text-left">2026 © <span class="font-bold text-recilog-green">Recilog</span></p>
		<p class="flex-1 text-center text-[15px] text-recilog-gray sm:text-right">
			Desarrollado por <span class="font-bold text-recilog-green">Indra Solutions</span>
		</p>
	</div>
</footer>
