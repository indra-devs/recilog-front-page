---
import Button from "./Button.astro";
import Logo from "./Logo.astro";

const links = [
	{ label: "Inicio", href: "/" },
	{ label: "Nosotros", href: "/nosotros" },
	{ label: "Servicios", href: "/servicios" },
	{ label: "Vehículos y Contenedores", href: "/vehiculos-contenedores" },
	{ label: "Contáctenos", href: "/contacto" },
];

const currentPath = Astro.url.pathname;
---

<header class="relative z-50 flex h-16 w-full items-center justify-between bg-white px-4 py-3 drop-shadow-[0px_3px_17px_rgba(0,0,0,0.08)] sm:px-6 md:px-10 lg:h-[90px] lg:px-16 xl:px-24 2xl:px-[240px]">
	<Logo />

	<nav class="hidden flex-1 items-center justify-center gap-6 xl:flex">
		{
			links.map((link) => (
				<a
					href={link.href}
					class={`font-heading text-[15px] font-semibold whitespace-nowrap ${currentPath === link.href ? "text-recilog-green" : "text-recilog-dark"}`}
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<div class="hidden shrink-0 items-center justify-end gap-6 xl:flex xl:w-[300px]">
		<Button label="¡HABLEMOS!" href="#contacto" />
		<a
			href="https://tcrm-front.vercel.app/login"
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center gap-2"
		>
			<span class="relative inline-block size-[18px]">
				<img src="/images/icons/user-1.svg" alt="" class="absolute top-[8%] left-[29%] h-[42%] w-[42%]" />
				<img src="/images/icons/user-2.svg" alt="" class="absolute bottom-[8%] left-[14%] h-[29%] w-[72%]" />
			</span>
			<span class="font-heading text-[15px] font-semibold text-recilog-dark">Ingresar</span>
		</a>
	</div>

	<div class="xl:hidden">
		<input type="checkbox" id="nav-toggle" class="peer hidden" />
		<label
			for="nav-toggle"
			aria-label="Abrir menú"
			class="relative flex size-10 cursor-pointer flex-col items-center justify-center gap-1.5"
		>
			<span class="h-0.5 w-6 rounded-full bg-recilog-dark"></span>
			<span class="h-0.5 w-6 rounded-full bg-recilog-dark"></span>
			<span class="h-0.5 w-6 rounded-full bg-recilog-dark"></span>
		</label>

		<div class="absolute inset-x-0 top-16 z-50 hidden flex-col gap-4 bg-white p-6 shadow-lg peer-checked:flex">
			{
				links.map((link) => (
					<a
						href={link.href}
						class={`font-heading text-[15px] font-semibold whitespace-nowrap ${currentPath === link.href ? "text-recilog-green" : "text-recilog-dark"}`}
					>
						{link.label}
					</a>
				))
			}
			<a
				href="https://tcrm-front.vercel.app/login"
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-2"
			>
				<span class="relative inline-block size-[18px]">
					<img src="/images/icons/user-1.svg" alt="" class="absolute top-[8%] left-[29%] h-[42%] w-[42%]" />
					<img src="/images/icons/user-2.svg" alt="" class="absolute bottom-[8%] left-[14%] h-[29%] w-[72%]" />
				</span>
				<span class="font-heading text-[15px] font-semibold text-recilog-dark">Ingresar</span>
			</a>
			<Button label="¡HABLEMOS!" href="#contacto" class="w-full" />
		</div>
	</div>
</header>
