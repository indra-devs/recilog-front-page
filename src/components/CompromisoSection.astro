---
const items = [
	{
		title: "Misión",
		text: "Ser la mejor opción en el transporte de residuos y materiales no peligrosos para clientes empresariales y domiciliarios, entregando soluciones adecuadas y apoyo oportuno.",
	},
	{
		title: "Visión",
		text: "Ofrecer un servicio rápido, confiable y de calidad, asegurando el traslado y acopio en lugares seguros, con mirada de futuro, responsabilidad operativa y foco total en cumplir lo comprometido con cada cliente.",
	},
	{
		title: "Valores",
		text: "Rapidez, confiabilidad, seguridad, eficiencia y responsabilidad, con el mismo compromiso para todos nuestros clientes, sin importar su tamaño.",
	},
];
---

<section class="relative  bg-white px-4 py-12 sm:px-6 md:px-10 md:py-16 lg:px-16 lg:py-[60px] xl:px-24 2xl:px-[240px]">
	<img
		src="/images/contacto/hojas-1.png"
		alt=""
		class="pointer-events-none absolute -top-40 right-2 hidden w-[280px] -rotate-12 md:block md:w-[360px] lg:w-[440px]"
	/>

	<h2 class="relative z-10 mb-10 text-center font-heading text-3xl font-bold text-recilog-dark md:mb-14 md:text-4xl lg:text-[54px]">
		Nuestro <span class="text-recilog-green">Compromiso</span>
	</h2>

	<div class="relative z-10 flex flex-col items-stretch gap-6 lg:flex-row">
		{
			items.map((item) => (
				<div class="flex w-full flex-1 flex-col items-center gap-4 rounded-2xl bg-white p-6 text-center drop-shadow-[0px_0px_10px_rgba(10,31,68,0.1)]">
					<p class="font-heading text-[30px] font-bold text-recilog-green">{item.title}</p>
					<p class="text-[18px] text-recilog-gray">{item.text}</p>
				</div>
			))
		}
	</div>
</section>
