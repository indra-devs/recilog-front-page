---
import Layout from "../layouts/Layout.astro";
---

<Layout title="RECILOG — Sitio en construcción">
	<main class="flex min-h-dvh flex-col items-center justify-center bg-recilog-bg px-4 text-center">
		<div class="flex h-[48px] items-center" aria-label="RECILOG">
			<img src="/images/logo/logo-part1.svg" alt="" class="h-full w-auto" />
			<img src="/images/logo/logo-part2.svg" alt="" class="h-full w-auto" />
		</div>
		<h1 class="mt-10 font-heading text-4xl font-bold text-recilog-dark sm:text-5xl">
			En construcción
		</h1>
		<p class="mt-4 max-w-md font-sans text-lg text-recilog-gray">
			Estamos trabajando en nuestro sitio. Vuelve pronto.
		</p>
	</main>
</Layout>
